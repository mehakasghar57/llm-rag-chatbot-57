# Copy this file to `.env` and fill in your key.
# NEVER commit the real .env file (it is listed in .gitignore).

# The ONLY required secret. Free key: https://console.groq.com/keys (no credit card)
GROQ_API_KEY=your_groq_api_key_here

# Default free-tier chat model. Check https://console.groq.com/docs/models for the current list.
GROQ_MODEL=openai/gpt-oss-20b

# --- Optional ---
# Models shown in the model picker (comma separated). The default model is always included.
# GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
# Replace the assistant's personality / instructions:
# SYSTEM_PROMPT=You are a friendly assistant for my company.
# MAX_ANSWER_TOKENS=1024
# CHUNK_SIZE=800
# CHUNK_OVERLAP=120
# MAX_UPLOAD_MB=3
# MAX_DOCS=10
